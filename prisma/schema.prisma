// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("admin_users")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("announcements")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  location    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("events")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("pages")
}

model MarketplacePost {
  id              String   @id @default(cuid())
  title           String
  description     String
  category        String
  type            String   // "sell", "buy", "trade"
  price           Float?
  authorId        String   @default("legacy-user") @map("author_id")
  authorName      String   @map("author_name")
  authorEmail     String   @map("author_email")
  authorPhone     String?  @map("author_phone")
  isSold          Boolean  @default(false) @map("is_sold")
  isActive        Boolean  @default(true) @map("is_active")
  images          String?  // JSON array of image URLs
  turnstileToken  String?  @map("turnstile_token")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  replies         MarketplaceReply[]
  
  @@map("marketplace_posts")
}

model MarketplaceReply {
  id             String   @id @default(cuid())
  content        String
  authorId       String   @default("legacy-user") @map("author_id")
  authorName     String   @map("author_name")
  authorEmail    String   @map("author_email")
  authorPhone    String?  @map("author_phone")
  postId         String   @map("post_id")
  images         String?  // JSON array of image URLs
  turnstileToken String?  @map("turnstile_token")
  createdAt      DateTime @default(now()) @map("created_at")
  
  post           MarketplacePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@map("marketplace_replies")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventRequest {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  unitNumber      String
  email           String
  phone           String
  isOwner         Boolean
  
  eventTitle      String
  eventDescription String?
  requestedDateTime DateTime

  status          RequestStatus @default(PENDING)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  fileType    String   @map("file_type") // "pdf", "doc", "docx"
  fileSize    Int      @map("file_size") // in bytes
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("documents")
}

enum ScooterRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  KEY_ISSUED
  DEPOSIT_PAID
}

model ScooterRegistration {
  id                  String                     @id @default(cuid())
  registrationId      String                     @unique @map("registration_id") // SR-timestamp format
  
  // Form data
  registrationDate    String                     @map("registration_date") // Date from form
  unitNumber          String                     @map("unit_number")
  numberOfScooters    Int                        @map("number_of_scooters")
  description         String                     // Make, Model, Features
  ownerNames          String                     @map("owner_names")
  email               String
  phone               String?
  
  // Admin fields
  status              ScooterRegistrationStatus  @default(PENDING)
  keyNumber           String?                    @map("key_number")
  depositPaid         Boolean                    @default(false) @map("deposit_paid")
  depositAmount       Float                      @default(50.0) @map("deposit_amount")
  notes               String?                    // Admin notes
  
  // Email tracking
  emailSent           Boolean                    @default(false) @map("email_sent")
  
  // Metadata
  isActive            Boolean                    @default(true) @map("is_active")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  
  @@map("scooter_registrations")
}

enum ContactMethod {
  EMAIL
  TELEPHONE
}

model ACInquiry {
  id                    String        @id @default(cuid())
  inquiryId             String        @unique @map("inquiry_id") // AC-timestamp format
  
  // Form data
  ownerName             String        @map("owner_name")
  ownerUnit             String        @map("owner_unit")
  ownerPhone            String        @map("owner_phone")
  email                 String
  isMultiZone           Boolean       @default(false) @map("is_multi_zone") // true for multi-zone, false for single-zone
  bestContactMethod     ContactMethod @map("best_contact_method")
  installationTiming    String        @map("installation_timing")
  notes                 String?       // Optional notes
  consentGiven          Boolean       @map("consent_given") // Required consent checkbox
  
  // Email tracking
  emailSent             Boolean       @default(false) @map("email_sent")
  
  // Metadata
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  
  @@map("ac_inquiries")
}

model StorageRental {
  id                    String        @id @default(cuid())
  rentalId              String        @unique @map("rental_id") // SR-timestamp format
  
  // Form data
  firstName             String        @map("first_name")
  lastName              String        @map("last_name")
  phoneNumber           String        @map("phone_number")
  email                 String
  unitNumber            String        @map("unit_number")
  bestContactMethod     ContactMethod @map("best_contact_method")
  interestedInInfo      Boolean       @map("interested_in_info") // Interest checkbox
  consentGiven          Boolean       @map("consent_given") // Required consent checkbox
  notes                 String?       // Optional notes/comments
  
  // Email tracking
  emailSent             Boolean       @default(false) @map("email_sent")
  
  // Metadata
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  
  @@map("storage_rentals")
}
