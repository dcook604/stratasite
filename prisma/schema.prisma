// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("admin_users")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("announcements")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  location    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("events")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("pages")
}

model MarketplacePost {
  id              String   @id @default(cuid())
  title           String
  description     String
  category        String
  type            String   // "sell", "buy", "trade"
  price           Float?
  authorId        String   @default("legacy-user") @map("author_id")
  authorName      String   @map("author_name")
  authorEmail     String   @map("author_email")
  authorPhone     String?  @map("author_phone")
  isSold          Boolean  @default(false) @map("is_sold")
  isActive        Boolean  @default(true) @map("is_active")
  images          String?  // JSON array of image URLs
  turnstileToken  String?  @map("turnstile_token")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  replies         MarketplaceReply[]
  
  @@map("marketplace_posts")
}

model MarketplaceReply {
  id             String   @id @default(cuid())
  content        String
  authorId       String   @default("legacy-user") @map("author_id")
  authorName     String   @map("author_name")
  authorEmail    String   @map("author_email")
  authorPhone    String?  @map("author_phone")
  postId         String   @map("post_id")
  images         String?  // JSON array of image URLs
  turnstileToken String?  @map("turnstile_token")
  createdAt      DateTime @default(now()) @map("created_at")
  
  post           MarketplacePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@map("marketplace_replies")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventRequest {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  unitNumber      String
  email           String
  phone           String
  isOwner         Boolean
  
  eventTitle      String
  eventDescription String?
  requestedDateTime DateTime

  status          RequestStatus @default(PENDING)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  fileType    String   @map("file_type") // "pdf", "doc", "docx"
  fileSize    Int      @map("file_size") // in bytes
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("documents")
}

enum ScooterRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  KEY_ISSUED
  DEPOSIT_PAID
}

model ScooterRegistration {
  id                  String                     @id @default(cuid())
  registrationId      String                     @unique @map("registration_id") // SR-timestamp format
  
  // Form data
  registrationDate    String                     @map("registration_date") // Date from form
  unitNumber          String                     @map("unit_number")
  numberOfScooters    Int                        @map("number_of_scooters")
  description         String                     // Make, Model, Features
  ownerNames          String                     @map("owner_names")
  email               String
  phone               String?
  
  // Admin fields
  status              ScooterRegistrationStatus  @default(PENDING)
  keyNumber           String?                    @map("key_number")
  depositPaid         Boolean                    @default(false) @map("deposit_paid")
  depositAmount       Float                      @default(50.0) @map("deposit_amount")
  notes               String?                    // Admin notes
  
  // Email tracking
  emailSent           Boolean                    @default(false) @map("email_sent")
  
  // Metadata
  isActive            Boolean                    @default(true) @map("is_active")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  
  @@map("scooter_registrations")
}

enum ContactMethod {
  EMAIL
  TELEPHONE
}

model ACInquiry {
  id                    String        @id @default(cuid())
  inquiryId             String        @unique @map("inquiry_id") // AC-timestamp format
  
  // Form data
  ownerName             String        @map("owner_name")
  ownerUnit             String        @map("owner_unit")
  ownerPhone            String        @map("owner_phone")
  email                 String
  isMultiZone           Boolean       @default(false) @map("is_multi_zone") // true for multi-zone, false for single-zone
  bestContactMethod     ContactMethod @map("best_contact_method")
  installationTiming    String        @map("installation_timing")
  notes                 String?       // Optional notes
  consentGiven          Boolean       @map("consent_given") // Required consent checkbox
  
  // Metadata
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  
  @@map("ac_inquiries")
}

model StorageRental {
  id                    String        @id @default(cuid())
  rentalId              String        @unique @map("rental_id") // SR-timestamp format
  
  // Form data
  firstName             String        @map("first_name")
  lastName              String        @map("last_name")
  phoneNumber           String        @map("phone_number")
  email                 String
  unitNumber            String        @map("unit_number")
  bestContactMethod     ContactMethod @map("best_contact_method")
  interestedInInfo      Boolean       @map("interested_in_info") // Interest checkbox
  consentGiven          Boolean       @map("consent_given") // Required consent checkbox
  notes                 String?       // Optional notes/comments
  
  // Metadata
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  
  @@map("storage_rentals")
}

enum PetOwnerOccupancyType {
  TENANT
  OWNER_OCCUPIED
}

enum PetRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmergencyContact {
  id                    String   @id @default(cuid())
  contactId             String   @unique @map("contact_id") // EC-timestamp format
  
  // Unit Information
  unitNumber            String   @map("unit_number")
  strataLotNumber       String   @map("strata_lot_number")
  registeredOwnerNames  String   @map("registered_owner_names")
  ownerEmail            String?  @map("owner_email")
  
  // Contact Phone Numbers
  phoneHome             String?  @map("phone_home")
  phoneBusiness         String?  @map("phone_business")
  phoneOther            String?  @map("phone_other")
  phoneOtherSpecify     String?  @map("phone_other_specify")
  
  // Non-resident Information
  nonResidentAddress    String?  @map("non_resident_address")
  nonResidentPhone      String?  @map("non_resident_phone")
  
  // Emergency Contact Information
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactAddress String? @map("emergency_contact_address")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  emergencyContactEmail String?  @map("emergency_contact_email")
  
  // Access Information
  allowManagementAccess String   @map("allow_management_access") // "YES" or "NO"
  conciergeKeyProvided String   @map("concierge_key_provided") // "YES" or "NO"
  dateProvidedToConcierge String? @map("date_provided_to_concierge")
  securityCode          String?  @map("security_code")
  
  // Metadata
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  @@map("emergency_contacts")
}

model PetRegistration {
  id                  String                   @id @default(cuid())
  registrationId      String                   @unique @map("registration_id") // PR-timestamp format
  
  // Owner/Tenant Information
  ownerName           String                   @map("owner_name")
  suiteNumber         String                   @map("suite_number")
  phoneNumber         String                   @map("phone_number")
  email               String
  occupancyType       PetOwnerOccupancyType    @map("occupancy_type")
  
  // Pet Registration Details
  petName             String                   @map("pet_name")
  petAge              String                   @map("pet_age")
  petHeight           String                   @map("pet_height")
  petColor            String                   @map("pet_color")
  petType             String                   @map("pet_type")
  petBreed            String                   @map("pet_breed")
  petWeight           String                   @map("pet_weight")
  distinguishingMarks String?                  @map("distinguishing_marks")
  licenseNumber       String?                  @map("license_number")
  photos              String?                  // JSON array of photo file paths
  
  // Admin fields
  status              PetRegistrationStatus    @default(PENDING)
  notes               String?                  // Admin notes
  
  // Email tracking
  emailSent           Boolean                  @default(false) @map("email_sent")
  
  // Metadata
  isActive            Boolean                  @default(true) @map("is_active")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  
  @@map("pet_registrations")
}

model FormConfiguration {
  id          String   @id @default(cuid())
  formName    String   @unique @map("form_name") // e.g., "scooter-registration"
  displayName String   @map("display_name") // e.g., "E-Scooter Registration"
  description String?  // Optional description
  isActive    Boolean  @default(true) @map("is_active")
  emailConfig Json     @map("email_config") // Email template and settings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  recipients  FormEmailRecipient[]
  
  @@map("form_configurations")
}

model FormEmailRecipient {
  id                String   @id @default(cuid())
  formConfigId      String   @map("form_config_id")
  email             String
  name              String?  // Optional display name
  isActive          Boolean  @default(true) @map("is_active")
  isPrimary         Boolean  @default(false) @map("is_primary") // Primary recipient
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  formConfiguration FormConfiguration @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  
  @@map("form_email_recipients")
}

model FormKSubmission {
  id                    String   @id @default(cuid())
  
  // Property Information
  strataPlan            String   @map("strata_plan")
  address               String
  unitNumber            String   @map("unit_number")
  strataLotNumber       String   @map("strata_lot_number")
  lockerNumber          String?  @map("locker_number")
  parkingStallNumbers   String?  @map("parking_stall_numbers")
  
  // Tenant 1 Information
  tenant1Name           String   @map("tenant1_name")
  tenant1HomePhone     String?  @map("tenant1_home_phone")
  tenant1OfficePhone   String?  @map("tenant1_office_phone")
  tenant1CellPhone     String?  @map("tenant1_cell_phone")
  tenant1Email         String?  @map("tenant1_email")
  
  // Tenant 2 Information (Optional)
  tenant2Name           String?  @map("tenant2_name")
  tenant2HomePhone     String?  @map("tenant2_home_phone")
  tenant2OfficePhone   String?  @map("tenant2_office_phone")
  tenant2CellPhone     String?  @map("tenant2_cell_phone")
  tenant2Email         String?  @map("tenant2_email")
  
  // Tenancy Information
  tenancyCommencingDay  String   @map("tenancy_commencing_day")
  tenancyCommencingDate String   @map("tenancy_commencing_date")
  tenancyCommencingYear String   @map("tenancy_commencing_year")
  
  // Landlord/Agent Information
  landlordName          String   @map("landlord_name")
  landlordAddress       String   @map("landlord_address")
  landlordSignatureName String   @map("landlord_signature_name") // Typed signature
  landlordSignatureDate String   @map("landlord_signature_date")
  
  // Tenant Signing Information
  tenantSigningMethod   String   @map("tenant_signing_method") // 'present' or 'email'
  
  // Tenant Signatures (when present)
  tenant1SignatureName  String?  @map("tenant1_signature_name")
  tenant1SignatureDate String?  @map("tenant1_signature_date")
  tenant2SignatureName String?  @map("tenant2_signature_name")
  tenant2SignatureDate String?  @map("tenant2_signature_date")
  
  // Signature Status Tracking
  landlordSignatureCompleted Boolean @default(false) @map("landlord_signature_completed")
  tenant1SignatureCompleted  Boolean @default(false) @map("tenant1_signature_completed")
  tenant2SignatureCompleted  Boolean @default(false) @map("tenant2_signature_completed")
  requiresTenantSignatures    Boolean @default(false) @map("requires_tenant_signatures")
  
  // Signature tokens for email workflow
  tenant1SignatureToken String? @map("tenant1_signature_token")
  tenant2SignatureToken String? @map("tenant2_signature_token")
  tenant1TokenExpiry    DateTime? @map("tenant1_token_expiry")
  tenant2TokenExpiry    DateTime? @map("tenant2_token_expiry")
  
  // Owner Information
  ownerMailingAddress   String   @map("owner_mailing_address")
  ownerHomePhone       String?  @map("owner_home_phone")
  ownerWorkPhone       String?  @map("owner_work_phone")
  ownerFax             String?  @map("owner_fax")
  ownerCellular        String?  @map("owner_cellular")
  ownerEmail           String?  @map("owner_email")
  
  // Form metadata
  submissionDate        String   @map("submission_date")
  isSubmitted          Boolean  @default(false) @map("is_submitted")
  emailSent            Boolean  @default(false) @map("email_sent")
  
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  
  @@map("form_k_submissions")
}
